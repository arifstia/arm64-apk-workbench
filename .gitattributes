# ARM64 APK Workbench - Git Attributes
# Created and maintained by arifstia

# Text files - normalize line endings
* text=auto

# Explicit text files
*.md text
*.txt text
*.py text
*.sh text
*.json text
*.yaml text
*.yml text
*.xml text
*.gradle text
*.properties text
*.conf text
*.cfg text
*.ini text

# Shell scripts - ensure LF
*.sh text eol=lf

# Python files - ensure LF
*.py text eol=lf

# Documentation - ensure LF
*.md text eol=lf

# Configuration - ensure LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files - don't touch
*.apk binary
*.jar binary
*.class binary
*.dex binary
*.so binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.zip binary
*.gz binary
*.bz2 binary
*.xz binary
*.7z binary
*.jks binary
*.keystore binary
*.p12 binary
*.pfx binary

# Large files - use LFS (if configured)
# *.apk filter=lfs diff=lfs merge=lfs -text
# *.jar filter=lfs diff=lfs merge=lfs -text

# Export ignore (files not included in git archive)
.gitignore export-ignore
.gitattributes export-ignore
install.sh export-ignore
uninstall.sh export-ignore
*.log export-ignore
logs/ export-ignore
.venv/ export-ignore
__pycache__/ export-ignore
build/ export-ignore
output/ export-ignore
decoded/ export-ignore
analysis/ export-ignore
patches/ export-ignore
backup/ export-ignore
original/ export-ignore
input/ export-ignore
reports/ export-ignore
.vscode/ export-ignore
.idea/ export-ignore
.opencode/ export-ignore